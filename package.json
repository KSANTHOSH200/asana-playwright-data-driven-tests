{
  "name": "asana-data-driven-playwright-evaluation",
  "version": "1.0.0",
  "private": true,
  "description": "Data-driven Playwright end-to-end tests for the Asana-like evaluation app",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.0",
    "typescript": "5.8.3"
  }
}
